# =================================================================
# FOMO Whale Signal Bot Configuration
# =================================================================

# Server Options
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Whale Threshold Settings ($500,000 USD)
# Minimum net worth of a wallet portfolio to be classified as a Whale
WHALE_MIN_PORTFOLIO_USD=500000.0

# Minimum single buy order in USD from a whale to trigger alert
WHALE_MIN_BUY_USD=500.0

# Scanner Intervals (in seconds)
SCAN_INTERVAL_SECONDS=3.0

# Notification Credentials (Optional)
# Telegram Bot Token & Chat ID (Get from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Network RPC Nodes
RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
RPC_BASE=https://mainnet.base.org
RPC_SOLANA=https://api.mainnet-beta.solana.com
